<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration - OWASP A09: Security Logging & Monitoring
  - CONSOLE: in ra terminal (dev)
  - FILE: logs/application.log - log toàn bộ ứng dụng (xoay vòng 30 ngày)
  - SECURITY_FILE: logs/security.log - log sự kiện bảo mật riêng (xoay vòng 90 ngày)
-->
<configuration>

    <!-- ===== CONSOLE APPENDER ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== APPLICATION LOG FILE (xoay vòng theo ngày, giữ 30 ngày) ===== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== SECURITY EVENT LOG FILE (giữ 90 ngày - phục vụ điều tra) ===== -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/security.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- Format: timestamp | level | event | user | ip | detail -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ===== SECURITY_EVENT logger - dành riêng cho bảo mật ===== -->
    <!-- additivity=false: không ghi thêm vào root logger, tránh trùng lặp -->
    <logger name="SECURITY_EVENT" level="INFO" additivity="false">
        <appender-ref ref="SECURITY_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- ===== Giảm noise từ Spring Security (chỉ log WARN trở lên trong prod) ===== -->
    <!-- Đang dùng DEBUG trong application.properties - giữ nguyên cho dev;   -->
    <!-- khi deploy production, đổi thành WARN bằng cách uncomment dòng dưới: -->
    <!-- <logger name="org.springframework.security" level="WARN"/> -->

    <!-- ===== ROOT LOGGER ===== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
